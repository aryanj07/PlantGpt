# Local dev defaults — safe to copy as-is to .env for running the skeleton with
# no external services. Real staging/prod values are injected via the deploy
# platform's secret manager (see ADR 3 / J.3 in the architecture plan), never
# committed here.

DEV_MODE=true

# Phase 1 replaces this with a real managed Postgres URL. If you're running
# docker-compose.dev.yml locally, swap in:
#   DATABASE_URL=postgresql+psycopg2://plantgpt:plantgpt@localhost:5432/plantgpt
DATABASE_URL=sqlite:///./dev.db

# Phase 1 replaces this with a real managed Redis URL. Works as-is once
# docker-compose.dev.yml's redis service is running.
REDIS_URL=redis://localhost:6379/0

# Backend-issued session JWT (HS256, this backend's own secret - never reuse
# this placeholder anywhere real). Short-lived by design (JWT_TTL_MINUTES).
JWT_SECRET=dev-only-placeholder-change-me
JWT_TTL_MINUTES=30

# Auth0 tenant this backend verifies tokens against (plan Section J.2).
# Domain looks like your-tenant.us.auth0.com; Audience is the API Identifier
# you set when creating the Auth0 API. Leave blank and DEV_MODE=true to keep
# using the X-Dev-Tenant-Id/X-Dev-User-Id fallback instead.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# Phase 1: LLM provider keys move here (server-side only) instead of the Flutter
# client's --dart-define flags. Leave blank in Phase 0 — the LLM Gateway module
# is still a stub.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
